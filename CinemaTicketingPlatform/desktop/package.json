{
  "name": "cinema-desktop",
  "version": "0.8.0",
  "private": true,
  "description": "电影购票平台桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cinema.platform",
    "productName": "CinemaTicketingPlatform",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend_dist"
      },
      {
        "from": "backend-dist",
        "to": "backend"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
